# Страницу всегда перепроверяем у сервера: в ней ссылки с версиями.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Снимок каталога меняется при каждой выкладке и версии в адресе не имеет.
/catalog.json
  Cache-Control: no-cache

/item.html
  Cache-Control: no-cache

/cart.html
  Cache-Control: no-cache

# Каталог My rent правится без смены адреса.
/my.json
  Cache-Control: no-cache

# Объявления правятся без смены адреса — тоже перепроверяем.
/announcements.json
  Cache-Control: no-cache

# Документы заменяют файлом на месте: имя то же, и устаревшая копия вредна.
/docs/*
  Cache-Control: no-cache

# Шрифты не меняются: имя файла — версия. Год и immutable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Файлы сезонных тем: имя версии нет, в ссылке стоит ?v=.
/themes/*
  Cache-Control: public, max-age=604800

/style.css
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: public, max-age=604800

/photos/*
  Cache-Control: public, max-age=604800
