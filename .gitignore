# Локальный кэш wrangler: появляется после выкладки на Cloudflare Pages и
# хранит id аккаунта и имя проекта. Это состояние инструмента, а не исходник.
.wrangler/

# Папка выкладки: собирается из index.html, css/ и js/ перед отправкой в Pages,
# чтобы на сайт не уехали apps-script/, worker/ и документация.
site/

node_modules/
